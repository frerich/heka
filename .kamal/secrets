# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

SECRET_KEY_BASE=$(echo $ANSIBLE_VAULT_PASSWORD | ansible-vault view prov/secrets.enc --vault-password-file /dev/stdin | yq .secret_key_base)
DEPLOY_PRIVATE_SSH_KEY=$(echo $ANSIBLE_VAULT_PASSWORD | ansible-vault view prov/secrets.enc --vault-password-file /dev/stdin | yq .deploy_ssh_private_key)
POSTGRES_USER=$(echo $ANSIBLE_VAULT_PASSWORD | ansible-vault view prov/secrets.enc --vault-password-file /dev/stdin | yq .postgres_user)
POSTGRES_PASSWORD=$(echo $ANSIBLE_VAULT_PASSWORD | ansible-vault view prov/secrets.enc --vault-password-file /dev/stdin | yq .postgres_password)
POSTGRES_DATABASE=$(echo $ANSIBLE_VAULT_PASSWORD | ansible-vault view prov/secrets.enc --vault-password-file /dev/stdin | yq .postgres_database)
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost/$POSTGRES_DATABASE
